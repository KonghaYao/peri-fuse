{
  "name": "peri-fuse-monorepo",
  "version": "0.1.0",
  "description": "Standalone lightweight LLM observability server — SQLite-backed, no Next.js, no ClickHouse, no Redis",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm --filter @peri-fuse/shared run build && pnpm --filter @peri/gateway run build && pnpm --filter @peri-fuse/server run build && pnpm --filter peri-fuse run build && pnpm --filter @peri-fuse/web run build",
    "dev": "concurrently \"LITE_SERVER_PORT=23432 pnpm --filter @peri-fuse/server run dev\" \"pnpm --filter @peri-fuse/web run dev\"",
    "dev:server": "LITE_SERVER_PORT=23432 pnpm --filter @peri-fuse/server run dev",
    "dev:web": "pnpm --filter @peri-fuse/web run dev",
    "start": "pnpm --filter @peri-fuse/server run start",
    "svc": "pnpm --filter peri-fuse exec peri-fuse",
    "svc:start": "pnpm --filter peri-fuse exec peri-fuse start",
    "svc:stop": "pnpm --filter peri-fuse exec peri-fuse stop",
    "svc:status": "pnpm --filter peri-fuse exec peri-fuse status",
    "svc:logs": "pnpm --filter peri-fuse exec peri-fuse logs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @peri-fuse/shared run db:generate",
    "release": "node scripts/release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "peri-fuse": "workspace:*",
    "concurrently": "^9.1.0"
  }
}
