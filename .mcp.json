{
  "mcpServers": {
    "langfuse": {
      "type": "http",
      "url": "http://localhost:23332/api/mcp",
      "headers": {
        "Authorization": "Basic <base64(publicKey:secretKey)>"
      },
      "protocolVersion": "2026-07-28"
    },
    "langfuse-dev": {
      "type": "http",
      "url": "http://localhost:23432/api/mcp",
      "headers": {
        "Authorization": "Basic <base64(publicKey:secretKey)>"
      },
      "protocolVersion": "2026-07-28"
    },
    "langfuse-stdio": {
      "type": "stdio",
      "command": "node",
      "args": [
        "packages/langfuse-mcp/dist/cli.js",
        "--stdio"
      ],
      "protocolVersion": "2026-07-28"
    }
  }
}
