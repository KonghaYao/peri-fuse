{
  "name": "@peri-fuse/langfuse-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the langfuse skill as MCP resources (2026-07-28)",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "start:stdio": "node dist/cli.js --stdio",
    "start:http": "node dist/cli.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@peri-code/mcpp": "^0.8.0",
    "@hono/node-server": "^1.19.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "esbuild": "^0.25.0"
  }
