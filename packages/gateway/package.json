{
  "name": "@peri/gateway",
  "version": "0.1.0",
  "description": "PeriGateway — unified LLM proxy gateway with rate limiting, budgets, and observability",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./admin-router": {
      "types": "./src/admin-router.ts",
      "default": "./dist/admin-router.js"
    },
    "./db": {
      "types": "./src/db.ts",
      "default": "./dist/db.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.1"
  }
}
