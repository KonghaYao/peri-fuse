{
  "name": "@peri-fuse/server",
  "version": "0.1.0",
  "description": "Standalone lightweight Peri-Fuse server (Lite mode, SQLite) - no Next.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:evals": "E2E_SCRIPT=langfuse-sdk-eval-e2e.mjs node e2e/run.mjs",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:check": "tsc",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dev": "tsx watch --clear-screen=false --ignore '../web/**' --ignore '../../node_modules/.vite/**' src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "author": "engineering@langfuse.com",
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@peri-fuse/shared": "workspace:*",
    "@peri/gateway": "workspace:*",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "protobufjs": "7.6.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.0",
    "dotenv-cli": "^7.4.4",
    "langfuse": "^3.38.20",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
