{
  "name": "@peri-fuse/cli",
  "version": "0.1.0",
  "description": "Peri-Fuse command-line tool — manage the background observability server",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "peri-fuse": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@peri-fuse/server": "workspace:*",
    "commander": "^14.0.1",
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
