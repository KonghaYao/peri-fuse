{
  "name": "peri-fuse",
  "version": "0.4.0",
  "description": "Peri-Fuse command-line tool — manage the background observability server",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "peri-fuse": "./dist/index.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.0.0",
    "commander": "^14.0.1",
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
