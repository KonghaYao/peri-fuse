diff --git a/dist/index.cjs b/dist/index.cjs
index f3298ad825bdb47228fdd4b6e81abfd18ac496bb..cf69f69d945e5292e6b162a2620cefa4a6e8ac22 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -145,10 +145,29 @@ function wrapAbortError(error) {
   }
   throw error;
 }
+function endpointUrl(baseUrl, endpoint) {
+  const url = new URL(baseUrl);
+  url.pathname = `${url.pathname.replace(/\/+$/, "")}${endpoint}`;
+  return url.toString();
+}
+async function fetchSession(ctx, endpoint, request, signal) {
+  const url = endpointUrl(ctx.url, endpoint);
+  const response = await fetch(url, buildFetchOptions(ctx, JSON.stringify(request), signal));
+  if (response.status !== 400 || !request.baton || !ctx.autocommit) return response;
+  let error;
+  try {
+    error = await response.clone().json();
+  } catch {
+    return response;
+  }
+  if (error.message !== "The stream has expired due to inactivity") return response;
+  await response.body?.cancel();
+  return fetch(url, buildFetchOptions(ctx, JSON.stringify({ ...request, baton: null }), signal));
+}
 async function executeCursor(ctx, request, signal) {
   let response;
   try {
-    response = await fetch(`${ctx.url}/v3/cursor`, buildFetchOptions(ctx, JSON.stringify(request), signal));
+    response = await fetchSession(ctx, "/v3/cursor", request, signal);
   } catch (error) {
     wrapAbortError(error);
   }
@@ -233,7 +252,7 @@ async function executeCursor(ctx, request, signal) {
 async function executePipeline(ctx, request, signal) {
   let response;
   try {
-    response = await fetch(`${ctx.url}/v3/pipeline`, buildFetchOptions(ctx, JSON.stringify(request), signal));
+    response = await fetchSession(ctx, "/v3/pipeline", request, signal);
   } catch (error) {
     wrapAbortError(error);
   }
