+// ---------------------------------------------------------------------------
+// [peri-fuse patch] STEP_IO stall guard.
+//
+// Native builds (`@tursodatabase/database` on Node) run `ioStep` as a no-op,
+// so `io()` only awaits a resolved promise. If the engine keeps returning
+// STEP_IO because its pending I/O can never make progress, the step loops
+// below spin on microtasks forever: the event loop is starved (timers,
+// sockets and request handlers stop running) and one core burns at 100% CPU
+// (upstream turso issue #7211). This guard is a mitigation, not a fix for the
+// underlying engine state:
+//   * every step result other than STEP_IO counts as progress and resets the
+//     clock, so long-running-but-progressing statements are unaffected;
+//   * once STEP_IO repeats without progress, polls yield to the macrotask
+//     queue (1ms timer) so the rest of the process keeps running;
+//   * once the stall exceeds the budget, the statement aborts with
+//     SQLITE_INTERRUPT instead of hanging the process forever.
+// Budget defaults to 10000ms; override via PERI_FUSE_STEP_IO_STALL_BUDGET_MS.
+const STEP_IO_STALL_BUDGET_MS = (() => {
+    const raw = globalThis.process?.env?.PERI_FUSE_STEP_IO_STALL_BUDGET_MS;
+    const parsed = raw === undefined ? 10000 : Number.parseInt(raw, 10);
+    return Number.isFinite(parsed) && parsed > 0 ? parsed : 10000;
+})();
+const STEP_IO_STALL_YIELD_AFTER = 16;
+class StepIoStallGuard {
+    constructor() {
+        this.progressAt = Date.now();
+        this.consecutiveIo = 0;
+    }
+    /** Record observed progress: any step result other than STEP_IO. */
+    progress() {
+        this.progressAt = Date.now();
+        this.consecutiveIo = 0;
+    }
+    /**
+     * Called for every STEP_IO result, before re-running `io()`. Returns a
+     * promise to await (a 1ms timer once polling is clearly unproductive) or
+     * undefined on the fast path. Throws SQLITE_INTERRUPT when the statement
+     * has been stuck past the stall budget.
+     */
+    wait() {
+        this.consecutiveIo += 1;
+        if (this.consecutiveIo < STEP_IO_STALL_YIELD_AFTER) {
+            return undefined;
+        }
+        const stalledMs = Date.now() - this.progressAt;
+        if (stalledMs >= STEP_IO_STALL_BUDGET_MS) {
+            throw new SqliteError(`Statement stuck in STEP_IO for ${stalledMs}ms without progress; aborted to protect the event loop (native ioStep is a no-op). See turso issue #7211; budget tunable via PERI_FUSE_STEP_IO_STALL_BUDGET_MS.`, "SQLITE_INTERRUPT");
+        }
+        return sleepBeforeRetry(1);
+    }
+}
