# Langfuse Lite Environment Configuration
# Copy this file to .env and adjust as needed.

# Server port (default: 23332)
LITE_SERVER_PORT=23332

# Force lite mode (do not change unless you know what you're doing)
LANGFUSE_MODE=lite

# SQLite database for auth/metadata (Prisma)
# Relative paths are resolved from the project root.
DATABASE_URL=file:.langfuse/langfuse.db

# SQLite database for telemetry (traces, observations, scores)
LANGFUSE_SQLITE_DB_PATH=.langfuse/telemetry.db

# Salt for API key hashing (set a random string in production)
SALT=
