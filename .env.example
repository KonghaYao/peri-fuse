# Peri-Fuse Environment Configuration
# Copy this file to .env and adjust as needed.

# Server port (default: 23332 for production CLI; use a different port for dev)
LITE_SERVER_PORT=23432

# Warn when a completed API response exceeds this many bytes (default: 1 MiB).
# The log contains request metadata and byte counts, never response bodies or auth headers.
#LITE_LARGE_RESPONSE_THRESHOLD_BYTES=1048576

# Runtime memory admission limits (details: docs/runtime-memory-limits.md).
# Active requests include uploads and responses until consumed or cancelled.
#LITE_MAX_ACTIVE_REQUESTS=64
#LITE_MAX_REQUEST_BYTES=16777216
#LITE_MAX_DECOMPRESSED_BYTES=33554432
# Standalone Gateway; embedded /v1 routes use the LITE limits above.
#GATEWAY_MAX_ACTIVE_REQUESTS=64
#GATEWAY_MAX_REQUEST_BYTES=16777216
# Request detail logging can be disabled without disabling spend accounting.
#GATEWAY_LOG_REQUESTS=true
#GATEWAY_LOG_MAX_BODY_SIZE=10240

# Force lite mode (do not change unless you know what you're doing)
LANGFUSE_MODE=lite

# Langfuse API (skill scripts: packages/langfuse-mcp/skills/langfuse/scripts/*, bunx langfuse-cli)
# Host must match the running server (same port as LITE_SERVER_PORT when using local lite).
#LANGFUSE_HOST=http://localhost:23432
#LANGFUSE_BASE_URL=http://localhost:23432
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
# MCP HTTP endpoint uses the same server and project-scoped Basic API key.
#LANGFUSE_MCP_URL=http://localhost:23432/api/mcp

# Global data directory. Local persistent state (Turso databases, salt,
# encryption key, daemon PID/logs) lives here. Defaults to ~/.peri-fuse.
# Uncomment to relocate, e.g. to keep data on a specific volume.
#PERIFUSE_HOME=/path/to/data

# Optional remote Turso storage for metadata, telemetry and Gateway.
# Both settings are required for remote mode. No local DB fallback on failure.
#TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
#TURSO_AUTH_TOKEN=your-database-token

# Optional per-domain overrides (priority: domain > global > legacy local settings).
# Tokens inherit TURSO_AUTH_TOKEN unless overridden here.
#TURSO_METADATA_DATABASE_URL=libsql://metadata-your-org.turso.io
#TURSO_METADATA_AUTH_TOKEN=metadata-token
#TURSO_TELEMETRY_DATABASE_URL=libsql://telemetry-your-org.turso.io
#TURSO_TELEMETRY_AUTH_TOKEN=telemetry-token
#TURSO_GATEWAY_DATABASE_URL=libsql://gateway-your-org.turso.io
#TURSO_GATEWAY_AUTH_TOKEN=gateway-token

# Local Turso database for auth/metadata (Drizzle).
# Defaults to <PERIFUSE_HOME>/langfuse.turso.db. Relative paths resolve from cwd.
#DATABASE_URL=file:/absolute/path/langfuse.turso.db

# Local Turso database for telemetry (traces, observations, scores).
# Defaults to <PERIFUSE_HOME>/telemetry.turso.db.
#LANGFUSE_SQLITE_DB_PATH=/absolute/path/telemetry.turso.db
#GATEWAY_DB_URL=file:/absolute/path/gateway.turso.db

# Salt for API key hashing. Auto-generated and persisted to <PERIFUSE_HOME>/.salt
# if left unset (set a random string in production).
SALT=

# Telemetry retention: purge traces/observations/scores older than N days.
# Disabled when unset or 0. Disk space is reclaimed on the next VACUUM
# (e.g. node scripts/prune-telemetry.mjs --before <date> --vacuum).
#PERIFUSE_TELEMETRY_RETENTION_DAYS=90
